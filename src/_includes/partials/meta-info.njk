{% if meta.title %}
  {% set pageTitle = metaTitle %}
{% elif site.name === title %}
  {% set pageTitle = title %}
{% else %}
  {% set pageTitle = title + ' • ' + site.name %}
{% endif %}

{% set currentUrl = site.url + page.url %}

{% set pageDesc = meta.desc or summary or site.desc %}

{% set pageImage = meta.imageSrc or site.socialImage %}

<title>{{ pageTitle }}</title>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
{# <link rel="apple-touch-icon" href="/path/to/icon.png"> #}

<link rel="canonical" href="{{ currentUrl }}">
<meta name="author" content="{{ site.authorName }}">
<meta name="description" content="{{ pageDesc }}">
<meta name="generator" content="11ty">

<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:url" content="{{ currentUrl }}">
<meta property="og:description" content="{{ pageDesc }}">
{% if pageImage %}
  <meta property="og:image" content="{{ pageImage }}">
  <meta property="og:image:width" content="{{ meta.imageWidth or 1200 }}">
  <meta property="og:image:height" content="{{ meta.imageHeight or 630 }}">
{% endif %}

<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ site.twitter }}">
<meta name="twitter:creator" content="{{ site.twitter }}">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
{% if pageImage %}
  <meta name="twitter:image" content="{{ pageImage }}">
  <meta name="twitter:image:alt" content="{{ meta.imageAlt or site.socialImageAlt }}">
{% endif %}